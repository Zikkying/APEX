# Reuse the Bohrium-hosted APEX base; no Docker Hub pull is needed.
FROM registry.dp.tech/dptech/dp/native/prod-397637/apex-flow:1.3.0.post

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN python3 -m venv --copies --system-site-packages /opt/apex-venv
ENV VIRTUAL_ENV=/opt/apex-venv
ENV PATH="/opt/apex-venv/bin:${PATH}"
RUN /opt/apex-venv/bin/python -m pip install --no-deps --ignore-installed apex-flow==1.3.2

RUN python - <<'PY'
import apex
assert apex.__version__ == '1.3.2', apex.__version__
from pathlib import Path
assert (Path(apex.__file__).parent / 'default_config/lammps/param_props.json').is_file()
print(apex.__version__)
PY

RUN python -m apex --help > /dev/null
RUN PIP_NO_INDEX=1 python -c "import runpy; from apex.skills import get_skill_root; runpy.run_path(str(get_skill_root() / 'scripts/ensure_apex.py'), run_name='__main__')"

CMD ["/bin/bash"]
