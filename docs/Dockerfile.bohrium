FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    openssh-server \
    supervisor \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel

RUN python -m pip install apex-flow==1.3.2

RUN python - <<'PY'
import apex
assert apex.__version__ == '1.3.2', apex.__version__
from pathlib import Path
assert (Path(apex.__file__).parent / 'default_config/lammps/param_props.json').is_file()
print(apex.__version__)
PY

RUN python -m apex --help > /dev/null
RUN PIP_NO_INDEX=1 python -c "import runpy; from apex.skills import get_skill_root; runpy.run_path(str(get_skill_root() / 'scripts/ensure_apex.py'), run_name='__main__')"

CMD ["/bin/bash"]
