# Portable Docker build recipe. For Bohrium's context-free Dockerfile API,
# use a build sandbox, upload the wheel/script, and commit the prepared sandbox.
FROM registry.dp.tech/dptech/dp/native/prod-397953/397637/apex-flow:1.3.2-post1@sha256:1bb08e4ddb750ef91cb7ed86b79f7d1153780fc244722ca13461b195b38fa76e
COPY *.whl /tmp/
COPY provision_cpu.sh /tmp/
RUN bash /tmp/provision_cpu.sh
ENV PATH=/opt/apex-venv/bin:/usr/local/bin:/usr/bin:/bin OMP_NUM_THREADS=1
